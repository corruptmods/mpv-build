         AVAudioSessionPortDescription *port = instance.currentRoute.outputs.firstObject;
@@ -1189,8 +1439,11 @@ static int init(struct ao *ao)
                 port ? port.portType.UTF8String : "none", (long)maxChannels);
     } else {
