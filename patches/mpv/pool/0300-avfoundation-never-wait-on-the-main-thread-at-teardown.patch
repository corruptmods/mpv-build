-// KVO observer for host-driven resizes of the --wid display layer. The
-// callback runs on whatever thread mutates the layer (the app's main
-// thread); it must only flag the change and wake the VO thread.
+// How long a retired layer stays hidden before it leaves the layer tree.
+// Leaving the tree drops the layer's video receiver and image queue, and on
+// macOS 27 tearing those down while WindowServer still composites the layer
+// can wedge the display: it stops presenting, the WindowServer watchdog
+// fires and the Mac panics (plezy#2823). Hidden first, the layer is out of
+// the frames WindowServer presents by then; 200 ms is several refreshes even
+// at 24 Hz.
+#define AVF_LAYER_RETIRE_DELAY_NS MP_TIME_MS_TO_NS(200)
+
+// --- avf main-thread link
+// The VO thread does not wait for the main thread, except for a bounded wait
+// in two places, and never while it tears down. A host may call a blocking
+// libmpv function, or mpv_terminate_destroy(), on its main thread, and
+// libmpv can be waiting for this VO at that moment (vo_create()'s preinit
+// rendezvous, a synchronous VOCTRL, the join on the VO thread at destroy).
+// A dispatch_sync() to the main queue from here then never returns.
+//
+// So everything the VO needs from the main thread goes through this object:
+//  - The main thread caches the layer's size in pixels and its gravity, from
+//    KVO and after every main-thread block that touches the layer; the VO
+//    thread reads the cache under the lock and queues a refresh, so a change
+//    KVO did not report reaches the next read.
+//  - The KVO and application-state callbacks reach the VO only through
+//    `vo`, which uninit clears under the lock (held only for the callbacks'
+//    atomic stores and vo_wakeup(), never across a main-thread wait), so a
+//    callback that runs after uninit finds no VO.
+//  - Teardown hands the observers, the layers and the timebase to a
+//    main-queue block that unregisters and releases them. Main-queue blocks
+//    run in order, so it always follows the block that registered them.
+//  - The two bounded waits (avf_link_run_on_main) are preinit's setup and
+//    the OSD layer's creation, whose results the VO uses on its next frame.
+//    Each waits at most AVF_MAIN_WAIT_NS; a block that runs later still
+//    completes and sets pending_main_late, and the VO adopts its result then.
+//
+// Locking: `lock` nests inside nothing the VO thread holds and is held over
+// vo_wakeup() (vo_internal.lock) only; the VO thread never takes it while it
+// holds vo_internal.lock.
+
+#define AVF_MAIN_WAIT_NS MP_TIME_MS_TO_NS(500)
+
 @interface MPVLayerGeometryObserver : NSObject {
 @public
-    struct vo *vo;
+    os_unfair_lock lock;
+    struct vo *vo;                      // lock; NULL once uninit detached it
+    // lock: the display layer's geometry as update_avfoundation_geometry
+    // used to read it on the main thread.
+    bool geometry_valid;
+    int geometry_w, geometry_h;
+    enum avf_gravity geometry_gravity;
+    atomic_bool refresh_queued;
+    // lock: an OSD layer the main thread made that the VO has not adopted,
+    // and whether one is being made / was dropped while it was.
+    AVSampleBufferDisplayLayer *pending_osd_layer;
+    bool osd_layer_creating, osd_layer_discard, osd_layer_orphaned;
+    // Main thread only.
+    AVSampleBufferDisplayLayer *layer;  // retained; released by teardown
+    bool observing;                     // KVO registered on `layer`
+    id app_resign_observer, app_active_observer;
+    bool presentation_suspended;
 }
 @end
 
+// Read the layer as update_avfoundation_geometry did and store it. Main
+// thread only: get_screen_scale() asks UIScreen/NSScreen.
+static void avf_link_refresh_geometry(MPVLayerGeometryObserver *link)
+{
+    AVSampleBufferDisplayLayer *displayLayer = link->layer;
+    if (!displayLayer)
+        return;
+
+    CGFloat scale = displayLayer.contentsScale > 0 ? displayLayer.contentsScale : get_screen_scale();
+    CGSize size = displayLayer.bounds.size;
+    if (size.width <= 0 || size.height <= 0)
+        size = displayLayer.frame.size;
+
+    int width = MPMAX(1, (int)(size.width * scale + 0.5));
+    int height = MPMAX(1, (int)(size.height * scale + 0.5));
+
+    enum avf_gravity gravity = AVF_GRAVITY_ASPECT;
+    AVLayerVideoGravity layerGravity = displayLayer.videoGravity;
+    if ([layerGravity isEqualToString:AVLayerVideoGravityResizeAspectFill])
+        gravity = AVF_GRAVITY_ASPECT_FILL;
+    else if ([layerGravity isEqualToString:AVLayerVideoGravityResize])
+        gravity = AVF_GRAVITY_RESIZE;
+
+    os_unfair_lock_lock(&link->lock);
+    link->geometry_valid = true;
+    link->geometry_w = width;
+    link->geometry_h = height;
+    link->geometry_gravity = gravity;
+    os_unfair_lock_unlock(&link->lock);
+}
+
+// Refresh the cache on the main thread soon; any thread. Coalesced.
+static void avf_link_queue_refresh(MPVLayerGeometryObserver *link)
+{
+    if (atomic_exchange(&link->refresh_queued, true))
+        return;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        atomic_store(&link->refresh_queued, false);
+        avf_link_refresh_geometry(link);
+    });
+}
+
+// The layer's size, scale or gravity changed: refresh the cache, then flag
+// the VO. The user shaders' output follows the layer's size and gravity; the
+// OSD only its size. Main thread.
+static void avf_link_layer_changed(MPVLayerGeometryObserver *link, bool gravity_only)
+{
+    avf_link_refresh_geometry(link);
+    os_unfair_lock_lock(&link->lock);
+    struct vo *target = link->vo;
+    if (target) {
+        struct priv *p = target->priv;
+        atomic_store(&p->shader_layer_stale, true);
+        if (!gravity_only)
+            atomic_store(&p->pending_layer_geometry_sync, true);
+        vo_wakeup(target);
+    }
+    os_unfair_lock_unlock(&link->lock);
+}
+
+// Run `block` on the main thread and wait up to AVF_MAIN_WAIT_NS for it.
+// Returns whether it ran in that time. If it did not, it still runs; it
+// then sets pending_main_late and wakes the VO, if the VO is still there.
+// The block must reach VO state only through the link: it can outlive the
+// VO.
+static bool avf_link_run_on_main(MPVLayerGeometryObserver *link,
+                                 dispatch_block_t block)
+{
+    if ([NSThread isMainThread]) {
+        block();
+        return true;
+    }
+
+    // 0: queued, 1: ran, 2: the waiter gave up. Under link->lock.
+    __block int state = 0;
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    dispatch_retain(done); // the block's reference
+    dispatch_async(dispatch_get_main_queue(), ^{
+        block();
+        os_unfair_lock_lock(&link->lock);
+        bool late = state == 2;
+        state = 1;
+        struct vo *target = link->vo;
+        if (late && target) {
+            struct priv *p = target->priv;
+            atomic_store(&p->pending_main_late, true);
+            vo_wakeup(target);
+        }
+        os_unfair_lock_unlock(&link->lock);
+        dispatch_semaphore_signal(done);
+        dispatch_release(done);
+    });
+
+    bool ran = dispatch_semaphore_wait(done,
+                   dispatch_time(DISPATCH_TIME_NOW, AVF_MAIN_WAIT_NS)) == 0;
+    if (!ran) {
+        os_unfair_lock_lock(&link->lock);
+        ran = state == 1;
+        if (!ran)
+            state = 2;
+        os_unfair_lock_unlock(&link->lock);
+    }
+    dispatch_release(done);
+    return ran;
+}
+
+// Hide a retired OSD layer now and take it out of the tree once that has
+// reached the screen (AVF_LAYER_RETIRE_DELAY_NS). Takes over the caller's
+// reference. Any thread.
+static void avf_retire_osd_layer(AVSampleBufferDisplayLayer *osdLayer)
+{
+    if (!osdLayer)
+        return;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        osdLayer.hidden = YES;
+        [CATransaction commit];
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, AVF_LAYER_RETIRE_DELAY_NS),
+                       dispatch_get_main_queue(), ^{
+            [osdLayer removeFromSuperlayer];
+            [osdLayer release];
+        });
+    });
+}
+
+// Take the OSD layer the main thread made, if there is one. Returns true when
+// one was taken or one is still being made (the caller must not start
+// another). VO thread.
+static bool avf_link_adopt_osd_layer(MPVLayerGeometryObserver *link,
+                                     AVSampleBufferDisplayLayer **out,
+                                     bool *orphaned)
+{
+    os_unfair_lock_lock(&link->lock);
+    bool busy = link->osd_layer_creating;
+    if (busy)
+        link->osd_layer_discard = false; // wanted after all
+    AVSampleBufferDisplayLayer *layer = link->pending_osd_layer;
+    link->pending_osd_layer = nil;
+    *orphaned = link->osd_layer_orphaned;
+    link->osd_layer_orphaned = false;
+    os_unfair_lock_unlock(&link->lock);
+    if (layer)
+        *out = layer;
+    return layer || busy;
+}
+
+// Drop an OSD layer the main thread made or is making for the VO. VO thread.
+static void avf_link_discard_osd_layer(MPVLayerGeometryObserver *link)
+{
+    os_unfair_lock_lock(&link->lock);
+    AVSampleBufferDisplayLayer *layer = link->pending_osd_layer;
+    link->pending_osd_layer = nil;
+    if (link->osd_layer_creating)
+        link->osd_layer_discard = true;
+    os_unfair_lock_unlock(&link->lock);
+    avf_retire_osd_layer(layer);
+}
+
+// After this no callback reaches `vo`. Called by uninit on the VO thread;
+// waits for at most a callback's atomic stores.
+static void avf_link_detach(MPVLayerGeometryObserver *link)
+{
+    os_unfair_lock_lock(&link->lock);
+    link->vo = NULL;
+    os_unfair_lock_unlock(&link->lock);
+}
+
+// Undo what preinit's setup registered, on the main thread, and release the
+// link: the observers, the KVO registration, the layers' timebase (only if
+// it is still this VO's) and any OSD layer nobody adopted. Takes over a
+// reference to `timebase` and the VO's reference to `link`. Any thread; never
+// waits.
+static void avf_link_teardown(MPVLayerGeometryObserver *link,
+                              AVSampleBufferDisplayLayer *osdLayer,
+                              CMTimebaseRef timebase)
+{
+    avf_link_detach(link);
+    dispatch_async(dispatch_get_main_queue(), ^{
+#if TARGET_OS_IPHONE
+        NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+        if (link->app_resign_observer) {
+            [nc removeObserver:link->app_resign_observer];
+            [link->app_resign_observer release];
+            link->app_resign_observer = nil;
+        }
+        if (link->app_active_observer) {
+            [nc removeObserver:link->app_active_observer];
+            [link->app_active_observer release];
+            link->app_active_observer = nil;
+        }
+#endif
+        AVSampleBufferDisplayLayer *displayLayer = link->layer;
+        if (link->observing) {
+            [displayLayer removeObserver:link forKeyPath:@"bounds"];
+            [displayLayer removeObserver:link forKeyPath:@"contentsScale"];
+            [displayLayer removeObserver:link forKeyPath:@"videoGravity"];
+            link->observing = false;
+        }
+        // A later VO on the same layer sets its own timebase in a block
+        // queued after this one; never clear one that is not ours.
+        if (timebase) {
+            if (displayLayer.controlTimebase == timebase)
+                displayLayer.controlTimebase = NULL;
+            if (osdLayer.controlTimebase == timebase)
+                osdLayer.controlTimebase = NULL;
+            CFRelease(timebase);
+        }
+        os_unfair_lock_lock(&link->lock);
+        AVSampleBufferDisplayLayer *orphan = link->pending_osd_layer;
+        link->pending_osd_layer = nil;
+        os_unfair_lock_unlock(&link->lock);
+        avf_retire_osd_layer(orphan);
+        link->layer = nil;
+        [displayLayer release];
+        [link release];
+    });
+}
+
