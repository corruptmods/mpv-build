@@ -795,7 +932,7 @@ void reload_audio_output(struct MPContext *mpctx)
     // to PCM again if necessary).
     if (ao_c && ao_c->track) {
         struct mp_decoder_wrapper *dec = ao_c->track->dec;
-        if (dec && ao_c->spdif_failed) {
+        if (dec && ao_c->spdif_failed && !spdif_backed_off(mpctx, ao_c->track)) {
             ao_c->spdif_passthrough = true;
             ao_c->spdif_failed = false;
             mp_decoder_wrapper_set_spdif_flag(ao_c->track->dec, true);
@@ -880,6 +1017,7 @@ void audio_start_ao(struct MPContext *mpctx)
 
