+// Whether this player backed off passthrough for the track's codec
+// (spdif_back_off) on the current audio route. A route that differs from the
+// one it failed on clears the entry: the new route gets to try again. An
+// unknown route on either side counts as the same. An entry also lapses
+// --audio-spdif-backoff-expiry seconds after its failure, and once
+// passthrough has played on the route (spdif_note_passthrough_playing), so
+// a single transient failure cannot cost passthrough for the session.
+static bool spdif_backed_off(struct MPContext *mpctx, struct track *track)
+{
+    if (!mpctx->opts->audio_spdif_backoff || !track || !track->stream ||
+        !track->stream->codec || !track->stream->codec->codec)
+        return false;
+    const char *codec = track->stream->codec->codec;
+    // Any device change on the route since the failure clears every entry,
+    // the same device coming back included: a receiver that was off or in
+    // the wrong mode often takes passthrough once it returns.
+    if (mpctx->num_spdif_backoff && ao_route_watch_fired(mpctx->spdif_route_watch)) {
+        MP_INFO(mpctx, "Audio route changed; trying passthrough again.\n");
+        mpctx->num_spdif_backoff = 0;
+        return false;
+    }
+    double expiry = mpctx->opts->audio_spdif_backoff_expiry;
+    for (int i = 0; i < mpctx->num_spdif_backoff; i++) {
+        struct spdif_backoff *b = &mpctx->spdif_backoff[i];
+        if (strcmp(b->codec, codec))
+            continue;
+        if (expiry > 0 && mp_time_ns() - b->failed_ns >= MP_TIME_S_TO_NS(expiry)) {
+            MP_INFO(mpctx, "%s passthrough back-off expired; trying it again.\n",
+                    codec);
+            mpctx->spdif_backoff[i] = mpctx->spdif_backoff[--mpctx->num_spdif_backoff];
+            return false;
+        }
+        char route[sizeof(b->route)];
+        if (b->route_known && ao_get_route_id(route, sizeof(route)) &&
+            strcmp(route, b->route))
+        {
+            MP_INFO(mpctx, "Audio route changed; trying %s passthrough again.\n",
+                    codec);
+            mpctx->spdif_backoff[i] = mpctx->spdif_backoff[--mpctx->num_spdif_backoff];
+            return false;
+        }
+        return true;
+    }
+    return false;
+}
+
+// The track's passthrough output failed while playing: decode its codec to
+// PCM on this player until the audio route changes, instead of losing the
+// seconds a failing output takes on every later file and output reload.
+static void spdif_back_off(struct MPContext *mpctx, struct track *track)
+{
+    if (!mpctx->opts->audio_spdif_backoff || !track || !track->stream ||
+        !track->stream->codec || !track->stream->codec->codec)
+        return;
+    const char *codec = track->stream->codec->codec;
+    struct spdif_backoff *b = NULL;
+    for (int i = 0; i < mpctx->num_spdif_backoff; i++) {
+        if (!strcmp(mpctx->spdif_backoff[i].codec, codec))
+            b = &mpctx->spdif_backoff[i];
+    }
+    if (!b) {
+        int max = MP_ARRAY_SIZE(mpctx->spdif_backoff);
+        if (mpctx->num_spdif_backoff == max) {
+            // Forget the oldest.
+            memmove(&mpctx->spdif_backoff[0], &mpctx->spdif_backoff[1],
+                    (max - 1) * sizeof(mpctx->spdif_backoff[0]));
+            mpctx->num_spdif_backoff--;
+        }
+        b = &mpctx->spdif_backoff[mpctx->num_spdif_backoff++];
+    }
+    snprintf(b->codec, sizeof(b->codec), "%s", codec);
+    b->route_known = ao_get_route_id(b->route, sizeof(b->route));
+    b->failed_ns = mp_time_ns();
+    mpctx->spdif_ok_since_ns = 0;
+    if (!mpctx->spdif_route_watch)
+        mpctx->spdif_route_watch = ao_route_watch_create();
+    else
+        ao_route_watch_fired(mpctx->spdif_route_watch); // changes before now don't count
+    MP_INFO(mpctx, "%s passthrough failed; decoding it to PCM on this audio "
+            "route from now on.\n", codec);
+}
+
+// How long a passthrough output must play, unpaused and without a failure,
+// before the back-off entries for its route lapse.
+#define SPDIF_BACKOFF_OK_NS MP_TIME_S_TO_NS(10)
+
+// Passthrough working on a route is evidence its earlier failure was
+// transient: once any codec's passthrough output has played for
+// SPDIF_BACKOFF_OK_NS, drop the entries recorded on the same route (an
+// unknown route counts as the same). Every playloop iteration.
+static void spdif_note_passthrough_playing(struct MPContext *mpctx)
+{
+    struct ao_chain *ao_c = mpctx->ao_chain;
+    bool playing = false;
+    if (mpctx->num_spdif_backoff && mpctx->ao && ao_c && ao_c->ao == mpctx->ao &&
+        ao_c->spdif_passthrough && mpctx->audio_status == STATUS_PLAYING &&
+        !mpctx->paused)
+    {
+        int rate, format;
+        struct mp_chmap channels;
+        ao_get_format(mpctx->ao, &rate, &format, &channels);
+        playing = af_fmt_is_spdif(format);
+    }
+    if (!playing) {
+        mpctx->spdif_ok_since_ns = 0;
+        return;
+    }
+    int64_t now = mp_time_ns();
+    if (!mpctx->spdif_ok_since_ns) {
+        mpctx->spdif_ok_since_ns = now;
+        return;
+    }
+    if (now - mpctx->spdif_ok_since_ns < SPDIF_BACKOFF_OK_NS)
+        return;
+    mpctx->spdif_ok_since_ns = 0;
+    char route[sizeof(mpctx->spdif_backoff[0].route)];
+    bool known = ao_get_route_id(route, sizeof(route));
+    int kept = 0;
+    for (int i = 0; i < mpctx->num_spdif_backoff; i++) {
+        struct spdif_backoff *b = &mpctx->spdif_backoff[i];
+        if (known && b->route_known && strcmp(route, b->route)) {
+            mpctx->spdif_backoff[kept++] = *b;
+            continue;
+        }
+        MP_INFO(mpctx, "Passthrough is playing on this audio route; trying %s "
+                "passthrough again.\n", b->codec);
+    }
+    mpctx->num_spdif_backoff = kept;
+}
+
