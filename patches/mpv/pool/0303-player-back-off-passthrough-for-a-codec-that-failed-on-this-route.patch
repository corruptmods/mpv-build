+// ao_get_route_id(): the outputs of the audio session's current route on
+// iOS/tvOS (port type and UID of each), the default output device's UID on
+// macOS.
+bool ao_avfoundation_route_id(char *buf, size_t size)
+{
+    if (!size)
+        return false;
+    buf[0] = '\0';
+#if TARGET_OS_IPHONE
+    @autoreleasepool {
+        AVAudioSessionRouteDescription *route = AVAudioSession.sharedInstance.currentRoute;
+        NSMutableString *id = [NSMutableString string];
+        for (AVAudioSessionPortDescription *port in route.outputs)
+            [id appendFormat:@"%@:%@;", port.portType, port.UID];
+        const char *str = id.UTF8String;
+        snprintf(buf, size, "%s", str ? str : "");
+        return true;
+    }
+#elif HAVE_COREAUDIO
+    AudioObjectID device = kAudioObjectUnknown;
+    AudioObjectPropertyAddress addr = {
+        kAudioHardwarePropertyDefaultOutputDevice,
+        kAudioObjectPropertyScopeGlobal,
+        0, // kAudioObjectPropertyElementMain
+    };
+    UInt32 len = sizeof(device);
+    if (AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL,
+                                   &len, &device) != noErr ||
+        device == kAudioObjectUnknown)
+        return false;
+    CFStringRef uid = NULL;
+    addr.mSelector = kAudioDevicePropertyDeviceUID;
+    len = sizeof(uid);
+    if (AudioObjectGetPropertyData(device, &addr, 0, NULL, &len, &uid) != noErr || !uid)
+        return false;
+    bool ok = CFStringGetCString(uid, buf, size, kCFStringEncodingUTF8);
+    CFRelease(uid);
+    return ok;
+#else
+    return false;
+#endif
+}
+
+#if TARGET_OS_IPHONE
+// ao_route_watch_*(): one AVAudioSession route-change observer. The flag
+// lives in this object, which the notification block retains, so a delivery
+// still in flight when the player destroys the watch writes into memory that
+// is still alive. Only reasons that mean the output device changed count; a
+// category change is left out, because a PCM output's own session setup
+// posts one right after the fallback that created the watch.
+@interface AVFRouteWatch : NSObject {
+@public
+    atomic_bool fired;
+    id token;
+}
+@end
+@implementation AVFRouteWatch
+@end
+
+struct ao_route_watch *ao_avfoundation_route_watch_create(void)
+{
+    AVFRouteWatch *w = [[AVFRouteWatch alloc] init];
+    atomic_init(&w->fired, false);
+    w->token = [[[NSNotificationCenter defaultCenter]
+        addObserverForName:AVAudioSessionRouteChangeNotification
+                    object:nil
+                     queue:nil
+                usingBlock:^(NSNotification *note) {
+        NSUInteger reason =
+            [note.userInfo[AVAudioSessionRouteChangeReasonKey] unsignedIntegerValue];
+        switch (reason) {
+        case AVAudioSessionRouteChangeReasonNewDeviceAvailable:
+        case AVAudioSessionRouteChangeReasonOldDeviceUnavailable:
+        case AVAudioSessionRouteChangeReasonOverride:
+        case AVAudioSessionRouteChangeReasonRouteConfigurationChange:
+            atomic_store(&w->fired, true);
+            break;
+        default:
+            break;
+        }
+    }] retain];
+    return (struct ao_route_watch *)w;
+}
+
+bool ao_avfoundation_route_watch_fired(struct ao_route_watch *watch)
+{
+    AVFRouteWatch *w = (AVFRouteWatch *)watch;
+    return atomic_exchange(&w->fired, false);
+}
+
+void ao_avfoundation_route_watch_destroy(struct ao_route_watch *watch)
+{
+    AVFRouteWatch *w = (AVFRouteWatch *)watch;
+    [[NSNotificationCenter defaultCenter] removeObserver:w->token];
+    [w->token release];
+    [w release];
+}
+#else
+// macOS has no route-change listener here; the route identity check alone
+// clears the back-off.
+struct ao_route_watch *ao_avfoundation_route_watch_create(void) { return NULL; }
+bool ao_avfoundation_route_watch_fired(struct ao_route_watch *w) { return false; }
+void ao_avfoundation_route_watch_destroy(struct ao_route_watch *w) {}
+#endif
