         error_on_track(mpctx, ao_c->track);
diff --git a/player/core.h b/player/core.h
index c3e0816..f56583b 100644
--- a/player/core.h
+++ b/player/core.h
@@ -176,6 +176,17 @@ struct vo_chain {
