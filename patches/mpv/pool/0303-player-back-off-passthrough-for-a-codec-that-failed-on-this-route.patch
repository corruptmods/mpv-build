 };
 
+// A codec whose passthrough output failed mid-stream on this player
+// (AO_EVENT_PASSTHROUGH_FAILED), and the audio route it failed on. Until the
+// route changes, the player decodes that codec to PCM instead of paying for
+// the failure again (--audio-spdif-backoff).
+struct spdif_backoff {
+    char codec[32];
+    char route[256];
+    bool route_known;
+    int64_t failed_ns;      // mp_time_ns() of the failure, for the expiry
+};
+
 // Like vo_chain, for audio.
 struct ao_chain {
     struct mp_log *log;
@@ -324,6 +335,14 @@ typedef struct MPContext {
     struct ao *ao;
     struct mp_aframe *ao_filter_fmt; // for weak gapless audio check
     struct ao_chain *ao_chain;
+    struct spdif_backoff spdif_backoff[8];
+    int num_spdif_backoff;
+    // Created with the first entry: any device change on the route since
+    // then clears the table, the same device coming back included.
+    struct ao_route_watch *spdif_route_watch;
+    // Since when a passthrough output has been playing on this player while
+    // entries exist (0: not now); see spdif_note_passthrough_playing().
+    int64_t spdif_ok_since_ns;
 
     struct vo_chain *vo_chain;
 
