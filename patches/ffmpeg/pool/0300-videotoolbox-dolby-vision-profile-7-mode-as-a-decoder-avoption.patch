     CFRelease(colorspace);
 }
 
+// --- vt dovi conversion mode
+// The values of the HEVC decoder's dv_conversion_mode option.
 enum PlezyDoviConversionMode {
-    PLEZY_DOVI_AUTO,
-    PLEZY_DOVI_DISABLED,
-    PLEZY_DOVI_DV81,
-    PLEZY_DOVI_HEVC_STRIP,
+    PLEZY_DOVI_AUTO = 0,
+    PLEZY_DOVI_DISABLED = 1,
+    PLEZY_DOVI_DV81 = 2,
+    PLEZY_DOVI_HEVC_STRIP = 3,
 };
 
-static enum PlezyDoviConversionMode videotoolbox_dovi_conversion_mode(void)
+static enum PlezyDoviConversionMode videotoolbox_dovi_env_mode(const char *mode)
 {
-    const char *mode = getenv("PLEZY_DV_CONVERSION_MODE");
-
     if (!mode || !mode[0] || !strcmp(mode, "auto"))
         return PLEZY_DOVI_AUTO;
     if (!strcmp(mode, "dv81") || !strcmp(mode, "p8") ||
@@ -978,45 +981,90 @@ static enum PlezyDoviConversionMode videotoolbox_dovi_conversion_mode(void)
     return PLEZY_DOVI_AUTO;
 }
 
-static int videotoolbox_dovi_needs_p81_conversion(const AVDOVIDecoderConfigurationRecord *dovi)
+// Once per hwaccel init: the decoder's dv_conversion_mode AVOption, or with
+// it unset (-1, its default) the environment, which embedders set before the
+// option existed: PLUET_DV_CONVERSION_MODE, else PLEZY_DV_CONVERSION_MODE.
+//
+// Every VideoToolbox hwaccel runs this init, and only HEVC has the option or
+// a use for it. Not every decoder's priv_data starts with an AVClass (VP9's
+// and ProRes's do not), so the option is looked up through the codec context
+// with AV_OPT_SEARCH_CHILDREN, which descends into priv_data only when the
+// codec has a priv_class (codec_child_next() in options.c).
+static void videotoolbox_dovi_resolve_mode(AVCodecContext *avctx, VTContext *vtctx)
+{
+    int64_t opt = -1;
+    const char *name = NULL, *env = NULL;
+
+    vtctx->dovi_mode = PLEZY_DOVI_AUTO;
+    if (avctx->codec_id != AV_CODEC_ID_HEVC)
+        return;
+    if (av_opt_get_int(avctx, "dv_conversion_mode", AV_OPT_SEARCH_CHILDREN, &opt) < 0)
+        opt = -1;
+    if (opt >= PLEZY_DOVI_AUTO && opt <= PLEZY_DOVI_HEVC_STRIP) {
+        vtctx->dovi_mode = opt;
+        return;
+    }
+    if ((env = getenv("PLUET_DV_CONVERSION_MODE")) && env[0])
+        name = "PLUET_DV_CONVERSION_MODE";
+    else if ((env = getenv("PLEZY_DV_CONVERSION_MODE")) && env[0])
+        name = "PLEZY_DV_CONVERSION_MODE";
+    vtctx->dovi_mode = videotoolbox_dovi_env_mode(name ? env : NULL);
+    if (name)
+        av_log(avctx, AV_LOG_VERBOSE, "Dolby Vision conversion mode %d from %s=%s\n",
+               vtctx->dovi_mode, name, env);
+}
+
+static enum PlezyDoviConversionMode videotoolbox_dovi_conversion_mode(AVCodecContext *avctx)
+{
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+
+    return vtctx ? vtctx->dovi_mode : PLEZY_DOVI_AUTO;
+}
+// --- end vt dovi conversion mode
+
+static int videotoolbox_dovi_needs_p81_conversion(AVCodecContext *avctx,
+                                                  const AVDOVIDecoderConfigurationRecord *dovi)
 {
-    enum PlezyDoviConversionMode mode = videotoolbox_dovi_conversion_mode();
+    enum PlezyDoviConversionMode mode = videotoolbox_dovi_conversion_mode(avctx);
 
     return dovi && dovi->dv_profile == 7 &&
            dovi->rpu_present_flag && dovi->bl_present_flag &&
            (mode == PLEZY_DOVI_AUTO || mode == PLEZY_DOVI_DV81);
 }
 
-static int videotoolbox_dovi_needs_hevc_strip(const AVDOVIDecoderConfigurationRecord *dovi)
+static int videotoolbox_dovi_needs_hevc_strip(AVCodecContext *avctx,
+                                              const AVDOVIDecoderConfigurationRecord *dovi)
 {
-    enum PlezyDoviConversionMode mode = videotoolbox_dovi_conversion_mode();
+    enum PlezyDoviConversionMode mode = videotoolbox_dovi_conversion_mode(avctx);
 
     return dovi && dovi->dv_profile == 7 &&
            dovi->rpu_present_flag && dovi->bl_present_flag &&
            mode == PLEZY_DOVI_HEVC_STRIP;
 }
 
-static int videotoolbox_dovi_effective_profile(const AVDOVIDecoderConfigurationRecord *dovi)
+static int videotoolbox_dovi_effective_profile(AVCodecContext *avctx,
+                                               const AVDOVIDecoderConfigurationRecord *dovi)
 {
     if (!dovi)
         return 0;
 
-    return videotoolbox_dovi_needs_p81_conversion(dovi) ? 8 : dovi->dv_profile;
+    return videotoolbox_dovi_needs_p81_conversion(avctx, dovi) ? 8 : dovi->dv_profile;
 }
 
-static CFDataRef videotoolbox_dovi_extradata_create(const AVDOVIDecoderConfigurationRecord *dovi)
+static CFDataRef videotoolbox_dovi_extradata_create(AVCodecContext *avctx,
+                                                    const AVDOVIDecoderConfigurationRecord *dovi)
 {
     uint8_t buf[24] = { 0 };
     uint16_t flags;
     int profile, el_present, bl_compatibility_id;
 
-    if (!videotoolbox_dovi_is_apple_hevc(dovi))
+    if (!videotoolbox_dovi_is_apple_hevc(avctx, dovi))
         return NULL;
 
-    profile = videotoolbox_dovi_effective_profile(dovi);
+    profile = videotoolbox_dovi_effective_profile(avctx, dovi);
     el_present = dovi->el_present_flag;
     bl_compatibility_id = dovi->dv_bl_signal_compatibility_id;
-    if (videotoolbox_dovi_needs_p81_conversion(dovi)) {
+    if (videotoolbox_dovi_needs_p81_conversion(avctx, dovi)) {
         el_present = 0;
         bl_compatibility_id = 1;
     }
@@ -1162,10 +1210,10 @@ static CFDictionaryRef videotoolbox_decoder_config_create(CMVideoCodecType codec
             CFDictionarySetValue(avc_info, CFSTR("hvcC"), data);
         if (codec_type == kCMVideoCodecType_DolbyVisionHEVC_FF) {
             dovi = videotoolbox_dovi_get_conf(avctx);
-            dovi_data = videotoolbox_dovi_extradata_create(dovi);
+            dovi_data = videotoolbox_dovi_extradata_create(avctx, dovi);
             if (dovi_data)
                 CFDictionarySetValue(avc_info,
-                                     videotoolbox_dovi_effective_profile(dovi) > 7 ? CFSTR("dvvC") : CFSTR("dvcC"),
+                                     videotoolbox_dovi_effective_profile(avctx, dovi) > 7 ? CFSTR("dvvC") : CFSTR("dvcC"),
                                      dovi_data);
         }
         break;
@@ -1252,9 +1300,9 @@ static int videotoolbox_start(AVCodecContext *avctx)
         {
             const AVDOVIDecoderConfigurationRecord *dovi = videotoolbox_dovi_get_conf(avctx);
 
-            if (videotoolbox_dovi_is_apple_hevc(dovi)) {
+            if (videotoolbox_dovi_is_apple_hevc(avctx, dovi)) {
                 videotoolbox->cm_codec_type = kCMVideoCodecType_DolbyVisionHEVC_FF;
-                if (videotoolbox_dovi_needs_p81_conversion(dovi)) {
+                if (videotoolbox_dovi_needs_p81_conversion(avctx, dovi)) {
                     av_log(avctx, AV_LOG_VERBOSE,
                            "Converting Dolby Vision profile 7 to profile 8.1 "
                            "for VideoToolbox.\n");
@@ -1576,8 +1624,8 @@ static int videotoolbox_hevc_decode_slice(AVCodecContext *avctx,
 {
     const AVDOVIDecoderConfigurationRecord *dovi = videotoolbox_dovi_get_conf(avctx);
 
-    if (videotoolbox_dovi_needs_p81_conversion(dovi) ||
-        videotoolbox_dovi_needs_hevc_strip(dovi))
+    if (videotoolbox_dovi_needs_p81_conversion(avctx, dovi) ||
+        videotoolbox_dovi_needs_hevc_strip(avctx, dovi))
         return videotoolbox_hevc_decode_dovi_slice(avctx, buffer, size);
 
     return videotoolbox_common_decode_slice(avctx, buffer, size);
@@ -1587,12 +1635,12 @@ static int videotoolbox_hevc_append_dovi_rpus(AVCodecContext *avctx)
 {
     HEVCContext *h = avctx->priv_data;
     const AVDOVIDecoderConfigurationRecord *dovi = videotoolbox_dovi_get_conf(avctx);
-    int convert_p7 = videotoolbox_dovi_needs_p81_conversion(dovi);
+    int convert_p7 = videotoolbox_dovi_needs_p81_conversion(avctx, dovi);
 
     if (!videotoolbox_session_is_dovi(avctx))
         return 0;
 
-    if (!videotoolbox_dovi_is_apple_hevc(dovi))
+    if (!videotoolbox_dovi_is_apple_hevc(avctx, dovi))
         return 0;
 
     for (int i = 0; i < h->pkt.nb_nals; i++) {
@@ -1757,6 +1805,7 @@ int ff_videotoolbox_common_init(AVCodecContext *avctx)
     bool full_range;
 
     vtctx->logctx = avctx;
+    videotoolbox_dovi_resolve_mode(avctx, vtctx);
 
     if (!avctx->hw_frames_ctx && !avctx->hw_device_ctx &&
             avctx->hwaccel_context)
diff --git a/libavcodec/vt_internal.h b/libavcodec/vt_internal.h
index b1eb073..5181aff 100644
--- a/libavcodec/vt_internal.h
+++ b/libavcodec/vt_internal.h
@@ -47,6 +47,11 @@ typedef struct VTContext {
     bool                        reconfig_needed;
 
     void *logctx;
+
+    // Dolby Vision profile 7 handling (enum PlezyDoviConversionMode), from
