+static int videotoolbox_dovi_is_apple_hevc(AVCodecContext *avctx,
+                                           const AVDOVIDecoderConfigurationRecord *dovi)
 {
     if (!dovi || !dovi->rpu_present_flag || !dovi->bl_present_flag)
